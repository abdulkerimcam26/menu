    <!-- JavaScript Mantığı -->
    <script>
        let cart = [];
        const WHATSAPP_NUMBER = "4917676859053"; // BURAYA KENDİ İŞLETME NUMARANIZI YAZIN (Örn: 905321234567)

        function addToCart(name, price) {
            let existingItem = cart.find(item => item.name === name);
            if (existingItem) {
                existingItem.quantity += 1;
            } else {
                cart.push({ name, price, quantity: 1 });
            }
            updateCartUI();
        }

        function changeQuantity(name, amount) {
            let item = cart.find(item => item.name === name);
            if (item) {
                item.quantity += amount;
                if (item.quantity <= 0) {
                    cart = cart.filter(i => i.name !== name);
                }
            }
            updateCartUI();
        }

        function updateCartUI() {
            let totalCount = cart.reduce((sum, item) => sum + item.quantity, 0);
            let totalPrice = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);

            document.getElementById('cart-count').innerText = totalCount;
            document.getElementById('cart-count-bar').innerText = totalCount;
            document.getElementById('total-price').innerText = totalPrice + " € ";

            let cartBar = document.getElementById('cart-bar');
            if (totalCount > 0) {
                cartBar.classList.remove('hidden');
            } else {
                cartBar.classList.add('hidden');
                document.getElementById('cart-modal').classList.add('hidden');
            }

            // Modal içi listeyi güncelle
            let listContainer = document.getElementById('cart-items-list');
            listContainer.innerHTML = '';
            cart.forEach(item => {
                listContainer.innerHTML += `
                    <div class="flex justify-between items-center py-2">
                        <div>
                            <p class="font-semibold text-sm">${item.name}</p>
                            <p class="text-xs text-amber-600">${item.price * item.quantity} €</p>
                        </div>
                        <div class="flex items-center space-x-2">
                            <button onclick="changeQuantity('${item.name}', -1)" class="bg-gray-200 px-2 py-0.5 rounded text-xs font-bold">-</button>
                            <span class="text-sm font-bold">${item.quantity}</span>
                            <button onclick="changeQuantity('${item.name}', 1)" class="bg-gray-200 px-2 py-0.5 rounded text-xs font-bold">+</button>
                        </div>
                    </div>
                `;
            });
        }

        function toggleCartModal() {
            if (cart.length === 0) return;
            let modal = document.getElementById('cart-modal');
            modal.classList.toggle('hidden');
        }

        function sendToWhatsApp() {
            const name = document.getElementById('customer-name').value.trim();
            const note = document.getElementById('customer-note').value.trim();

            if (!name) {
                alert("Lütfen sipariş için adınızı giriniz.");
                document.getElementById('customer-name').focus();
                return;
            }

            if (cart.length === 0) {
                alert("Sepetiniz boş!");
                return;
            }

            let totalPrice = 0;
            const lines = [
                "🔔 *YENİ SİPARİŞ GELDİ*",
                `👤 *Müşteri:* ${name}`
            ];

            if (note) {
                lines.push(`📝 *Not / Yer:* ${note}`);
            }

            lines.push("", "------------------------------");

            cart.forEach(item => {
                const itemTotal = item.price * item.quantity;
                totalPrice += itemTotal;
                lines.push(`▪️ *${item.quantity}x* ${item.name} (${itemTotal} €)`);
            });

            lines.push(
                "------------------------------",
                `💰 *TOPLAM TUTAR:* *${totalPrice} €*`,
                "*(Ödeme Kasada / Elden Alınacak)*"
            );

            const message = lines.join(String.fromCharCode(10));
            const whatsappURL =
                `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;

            window.open(whatsappURL, "_blank", "noopener,noreferrer");
        }
    </script>
